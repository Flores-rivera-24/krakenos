# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
*.tsbuildinfo

# Env & secrets
.env
.env.local
*.pem
*.key
keys/
certs/

# Estado en runtime del agente (registro de peers WireGuard, etc.)
data/

# Traspaso en runtime del agente: staging de restore (US-104) y de la
# actualización one-click (US-190: lock + resultado). Solo existe en despliegue.
var/

# Database
*.db
*.db-journal
# Ficheros del modo WAL (US-228): acompañan a cualquier *.db abierto.
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
prisma/dev.db*

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Editor / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# Vite / web
apps/web/dist/
apps/web/.vite/

# Test coverage (informes de vitest; NO los directorios fuente llamados
# "coverage", p. ej. apps/agent/src/coverage o apps/web/src/components/coverage).
/coverage/
apps/*/coverage/

# Documentos Word
~$*
*.docx

# Claude Code — config local del proyecto (no se comparte)
.claude/

# Documentación interna — no se publica en GitHub
/SPECS.md
/CLAUDE.md
/BACKLOG.md
/docs/history.md
# Auditorías y notas internas (contienen hallazgos sin corregir: NUNCA se publican)
/docs/internal/

# Material de marca — fuente local. Los assets que usa la web viven en apps/web/public/.
/Icons/

# Metadatos de descarga de Windows (Alternate Data Stream)
*:Zone.Identifier
