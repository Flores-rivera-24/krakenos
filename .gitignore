# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
*.tsbuildinfo

# Env & secrets
.env
.env.*
# Las plantillas sin secretos reales sí se versionan.
!.env.example
!.env.*.example
*.pem
*.key
keys/
certs/

# Estado en runtime del agente (registro de peers WireGuard, etc.)
data/

# Traspaso en runtime del agente: staging de restore (US-104) y de la
# actualización one-click (US-190: lock + resultado). Solo existe en despliegue.
var/

# Database
*.db
*.db-journal
# Ficheros del modo WAL (US-228): acompañan a cualquier *.db abierto.
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
prisma/dev.db*
# Excepción: la base SINTÉTICA escrita por Prisma 5 que usan los tests de la subida a
# Prisma 7 (US-276). No contiene datos de nadie; ver scripts/fixtures-prisma5/generar.mjs.
!apps/agent/test/fixtures/prisma5/prisma5.db

# Cliente de Prisma 7 generado (US-276): sale de `prisma generate` y se empaqueta en dist.
apps/agent/src/generated/

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Informes de QA (mutación, rendimiento): son RESULTADOS de una ejecución, se
# regeneran con `pnpm qa:*` y cambian en cada máquina. Lo que sí se versiona es
# el umbral que deben superar, que vive en la config de cada herramienta.
/qa-reports/
# Sandboxes temporales de Stryker: copia del árbol por mutante. Se limpian solos
# al terminar bien, pero una ejecución interrumpida los deja atrás.
.stryker-tmp/

# Editor / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# Vite / web
apps/web/dist/
apps/web/.vite/

# Test coverage (informes de vitest; NO los directorios fuente llamados
# "coverage", p. ej. apps/agent/src/coverage o apps/web/src/components/coverage).
/coverage/
apps/*/coverage/

# Documentos Word
~$*
*.docx

# Claude Code — config local del proyecto (no se comparte)
.claude/

# Documentación interna — no se publica en GitHub
/SPECS.md
/CLAUDE.md
/BACKLOG.md
/docs/history.md
# Auditorías y notas internas (contienen hallazgos sin corregir: NUNCA se publican)
/docs/internal/

# Material de marca — fuente local. Los assets que usa la web viven en apps/web/public/.
/Icons/

# Metadatos de descarga de Windows (Alternate Data Stream)
*:Zone.Identifier
