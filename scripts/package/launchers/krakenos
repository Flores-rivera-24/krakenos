#!/bin/sh
# Lanzador del paquete autocontenido de KrakenOS (Linux).
set -eu

PKG=$(CDPATH="" cd -- "$(dirname -- "$0")/.." && pwd)
export KRAKENOS_APP_DIR="$PKG/app/agent"
KRAKENOS_DATA_DIR="${KRAKENOS_DATA_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/krakenos}"
export KRAKENOS_DATA_DIR
export KRAKENOS_DEPLOY_MODE="${KRAKENOS_DEPLOY_MODE:-package}"
# Sin esto el agente no arranca: pino-pretty es devDependency y no viaja en el paquete.
export NODE_ENV=production

mkdir -p -- "$KRAKENOS_DATA_DIR"
cd -- "$KRAKENOS_DATA_DIR"

"$PKG/node/bin/node" "$PKG/app/first-run.mjs"
exec "$PKG/node/bin/node" "$PKG/app/agent/dist/index.js" "$@"
