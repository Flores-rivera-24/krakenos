{
  "name": "krakenos",
  "version": "0.1.0",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "type": "module",
  "description": "KrakenOS — plataforma de gestión de red doméstica e IoT",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "build": "pnpm -r build",
    "prod": "bash scripts/prod.sh",
    "dev": "pnpm -r --parallel dev",
    "dev:agent": "pnpm --filter @krakenos/agent dev",
    "dev:web": "pnpm --filter @krakenos/web dev",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:coverage": "pnpm -r test:coverage",
    "test:e2e": "playwright test -c e2e/playwright.config.ts",
    "test:e2e:stacks": "playwright test -c e2e/stacks/playwright.config.ts",
    "test:e2e:install": "playwright install chromium",
    "qa:mutation": "pnpm --filter @krakenos/agent exec stryker run",
    "qa:perf": "node scripts/qa/perf-api.mjs",
    "qa:deadcode": "knip --no-progress",
    "qa:compat": "E2E_BROWSERS=firefox playwright test -c e2e/playwright.config.ts --project=firefox",
    "qa:compat:install": "playwright install firefox",
    "qa": "pnpm lint && pnpm -r typecheck && pnpm test:coverage && pnpm qa:mutation && pnpm qa:deadcode",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "clean": "pnpm -r exec rm -rf dist node_modules .turbo && rm -rf node_modules"
  },
  "devDependencies": {
    "@axe-core/playwright": "4",
    "@eslint/js": "^9.9.0",
    "@playwright/test": "1.61.1",
    "@stryker-mutator/core": "9",
    "@stryker-mutator/vitest-runner": "9",
    "@types/node": "^20.14.0",
    "autocannon": "8",
    "eslint": "^9.9.0",
    "knip": "5",
    "prettier": "^3.3.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0"
  }
}
